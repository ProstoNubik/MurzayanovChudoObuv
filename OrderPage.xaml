<Page x:Class="MurzayanovChudoObuv.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MurzayanovChudoObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Название товара" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Размер" FontWeight="Bold" TextAlignment="Center" Grid.Column="1" Margin="10 0 "/>
            <TextBlock Text="Количество" FontWeight="Bold" TextAlignment="Center" Grid.Column="2" Margin="10 0"/>
        </Grid>

        <ListView Name="ProductItemsListView" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SizeCol"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CountCol"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding productItem.Products.Name}" TextAlignment="Center" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding productItem.Sizes.Size, StringFormat={}{0:0.#}}" TextAlignment="Center" Grid.Column="1" Margin="10 0"/>
                        <TextBlock Text="{Binding itemCount}" TextAlignment="Center" Grid.Column="2" Margin="10 0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Name="ConfirmOrderButton" Content="Подтвержить заказ" Width="200" Grid.Row="2" Click="ConfirmOrderButton_Click"/>
    </Grid>
</Page>
