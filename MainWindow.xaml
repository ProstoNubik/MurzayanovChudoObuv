<Window x:Class="MurzayanovChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MurzayanovChudoObuv"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1200" FontFamily="Calibri" Icon="/Images/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock Name="CurrentUserTextBlock" HorizontalAlignment="Right" Margin="5"/>

        <Image Source="/Images/Чудо Обувь.png" Width="70" HorizontalAlignment="Left" Grid.Row="1" Margin="5"/>
        <TextBlock Text="Чудо обувь" FontSize="30" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center"/>
        <Button Name="goBackButton" Content="Назад" HorizontalAlignment="Right" Grid.Row="1" Margin="0 0 10 0" Click="goBackButton_Click"/>

        <Frame Name="MainFrame" Grid.Row="2" Navigated="MainFrame_Navigated" NavigationUIVisibility="Hidden"/>

        <Grid Background="#D2F6E7" Grid.Row="3"/>
    </Grid>
</Window>
