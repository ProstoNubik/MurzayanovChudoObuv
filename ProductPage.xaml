<Page x:Class="MurzayanovChudoObuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MurzayanovChudoObuv"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200" FontFamily="Calibri"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Поиск" HorizontalAlignment="Center"/>
                <TextBox Name="SearchTextBox" Width="200" Height="30" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Сортировка по цене" HorizontalAlignment="Center"/>
                <ComboBox Name="SortComboBox" Width="200" SelectionChanged="SortComboBox_SelectionChanged">
                    <TextBlock/>
                    <TextBlock Text="По возрастанию"/>
                    <TextBlock Text="По убыванию"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Фильтрация по категории" HorizontalAlignment="Center"/>
                <ComboBox Name="FilterComboBox" Width="200" SelectionChanged="FilterComboBox_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" SelectionChanged="ProductListView_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{Binding ListColor}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="900"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Source="{Binding ImagePath, TargetNullValue='pack://application:,,,/Images/picture.png'}"  Grid.RowSpan="4" Width="150" Margin="5"/>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Manufactures.Name, StringFormat={}{0}|}" FontSize="22"/>
                            <TextBlock Text="{Binding Name}" FontSize="22"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Categories.Name,StringFormat=Категория:{0}}" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Text="{Binding ItemsCountText, StringFormat=Количество:{0}}" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock Text="{Binding Composition, StringFormat=Состав:{0}}" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding CostWithDiscount}" Grid.RowSpan="2" FontSize="26" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Name="OrderButton" Content="Сделать заказ" Grid.Row="2" HorizontalAlignment="Right" Margin="5" Visibility="Collapsed" Click="OrderButton_Click"/>
    </Grid>
</Page>
