<Window x:Class="MurzayanovChudoObuv.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MurzayanovChudoObuv"
        mc:Ignorable="d"
        Title="OrderWindow" Height="500" Width="800" FontFamily="Calibri">
    <Grid>
        <Grid.Resources>
            <Style x:Key="HeadersStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Grid.Column" Value="1"/>
                <Setter Property="Margin" Value="0 0 10 0"/>
            </Style>
            <Style x:Key="ValuesStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Grid.Column" Value="2"/>
            </Style>
        </Grid.Resources>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Source="{Binding ImagePath, TargetNullValue='pack://application:,,,/Images/picture.png'}" Grid.RowSpan="7" Width="150" Margin="5" VerticalAlignment="Center"/>

        <TextBlock Text="Производитель:" Style="{StaticResource HeadersStyle}"/>
        <TextBlock Text="Название:" Style="{StaticResource HeadersStyle}" Grid.Row="1"/>
        <TextBlock Text="Категория:" Style="{StaticResource HeadersStyle}" Grid.Row="2"/>
        <TextBlock Text="Состав:" Style="{StaticResource HeadersStyle}" Grid.Row="3" TextWrapping="Wrap"/>
        <TextBlock Text="Описание:" Style="{StaticResource HeadersStyle}" Grid.Row="4" TextWrapping="Wrap"/>
        <TextBlock Text="Размерный ряд:" Style="{StaticResource HeadersStyle}" Grid.Row="5"/>
        <TextBlock Text="Доступные размеры:" Style="{StaticResource HeadersStyle}" Grid.Row="6"/>
        <TextBlock Text="Выбранное количество:" Style="{StaticResource HeadersStyle}" Grid.Row="7"/>

        <TextBlock Text="{Binding Manufactures.Name}" Style="{StaticResource ValuesStyle}"/>
        <TextBlock Text="{Binding Name}" Style="{StaticResource ValuesStyle}" Grid.Row="1"/>
        <TextBlock Text="{Binding Categories.Name}" Style="{StaticResource ValuesStyle}" Grid.Row="2"/>
        <TextBlock Text="{Binding Composition}" Style="{StaticResource ValuesStyle}" Grid.Row="3" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Description}" Style="{StaticResource ValuesStyle}" Grid.Row="4" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SizesRange}" Style="{StaticResource ValuesStyle}" Grid.Row="5"/>
        <ComboBox Name="AvailableSizesComboBox" Grid.Column="2" Grid.Row="6" SelectedIndex="0" SelectionChanged="AvailableSizesComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Size, StringFormat=0.#}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="7">
            <Button Name="MinusCountButton" Width="20" Height="20" Content="-" Margin="10 0 2 0" Click="MinusCountButton_Click"/>
            <TextBlock Name="CountTextBlock" Text="0" VerticalAlignment="Center" Margin="2"/>
            <Button Name="PlusCountButton" Width="20" Height="20" Content="+" Margin="2 0 0 0" Click="PlusCountButton_Click"/>
        </StackPanel>

        <Button Name="OrderButton" Content="Оформить заказ" Grid.Row="8" Grid.ColumnSpan="3" Margin="10" Click="OrderButton_Click"/>
    </Grid>
</Window>
